#pragma once
#include <windows.h>
// Both identities change per source release. TSF also caches language profiles
// in long-running applications independently of their COM class identity.
inline const CLSID kService={0x7b3b1841,0xa842,0x4bc5,{@identity_bytes@}};
inline const GUID kProfile={0xe97a77be,0x9c2d,0x4e9d,{@profile_bytes@}};
inline const wchar_t* kSourceVersion=L"@source_hash@";
